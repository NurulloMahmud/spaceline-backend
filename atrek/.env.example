ENV=development
PORT=:8000
BASE_URL=http://localhost

JWT_SECRET=change-me-to-django-signing-key

ALLOWED_ORIGINS=https://mydomain.com,https://myseconddomain.com

DATABASE_URL=postgres://postgres:postgres@localhost:5432/atrek?sslmode=disable
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=atrek


REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

BUCKET_NAME=
BUCKET_REGION=
BUCKET_ACCESS_KEY=
BUCKET_SECRET_KEY=
BUCKET_PREFIX=

ATREK_WS_URL=wss://example-atrek-endpoint.com/ws
ATREK_AUTH_TOKEN=replace-with-real-atrek-credential
