# service
ENV=development
PORT=8100
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/email_agent
CORS_ORIGINS=http://localhost:3000

# database resilience — every wait is bounded so a stuck query or a starved
# pool cannot freeze the whole service. Defaults are sane; tune on the box
# without a redeploy if needed.
#   DB_POOL_TIMEOUT_SECONDS  how long a connection checkout may block (was 30)
#   DB_STATEMENT_TIMEOUT_MS  Postgres aborts a single query slower than this
#   DB_IDLE_TX_TIMEOUT_MS    Postgres drops a transaction left open this long,
#                            freeing the connection a stalled handler was holding
DB_POOL_TIMEOUT_SECONDS=10
DB_STATEMENT_TIMEOUT_MS=15000
DB_IDLE_TX_TIMEOUT_MS=60000

# auth — must match Django's SIMPLE_JWT signing key (defaults to SECRET_KEY)
JWT_SECRET=
JWT_ALGORITHM=HS256
# shared with atrek (INTERNAL_SECRET_KEY) and boxTruck (INTERNAL_SERVICE_SECRET)
INTERNAL_SECRET_KEY=

# peer services — ORIGIN ONLY, no /api or /api/v1 suffix.
# agent_bot's .env stores these same hosts *with* the suffix because its
# clients append bare paths; copying those values here would 404 everything.
BOXTRUCK_BASE_URL=https://spaceline.boxtruckmanage.com
BOXTRUCK_INTERNAL_SECRET=
ATREK_BASE_URL=http://localhost:8080
ATREK_INTERNAL_SECRET=

# openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# telegram — same bot token as agent_bot
TELEGRAM_BOT_TOKEN=

# separate bot + admin chat id, used only to alert on the client IP of each
# SSE connection to /api/v1/events/stream
IP_ALERT_BOT_TOKEN=
IP_ALERT_CHAT_ID=

# 0 means a ratecon total must equal the agreed rate exactly
PRICE_TOLERANCE_CENTS=0

# Shared mailbox that catches broker replies, read over IMAP (see README).
SHARED_INBOX_ADDRESS=
SHARED_INBOX_APP_PASSWORD=
SHARED_INBOX_IMAP_HOST=imap.gmail.com
SHARED_INBOX_FOLDER=INBOX
SHARED_INBOX_POLL_SECONDS=15

# Mailboxes connected with an app password (Admin > Mailboxes). The page is
# open to these BTM user ids only; the passwords rest encrypted with the
# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MAILBOX_ADMIN_USERS=
MAILBOX_SECRET_KEY=
