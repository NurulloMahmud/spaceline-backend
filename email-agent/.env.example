# service
ENV=development
PORT=8100
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/email_agent
CORS_ORIGINS=http://localhost:3000

# auth — must match Django's SIMPLE_JWT signing key (defaults to SECRET_KEY)
JWT_SECRET=
JWT_ALGORITHM=HS256
# shared with atrek (INTERNAL_SECRET_KEY) and boxTruck (INTERNAL_SERVICE_SECRET)
INTERNAL_SECRET_KEY=

# peer services — ORIGIN ONLY, no /api or /api/v1 suffix.
# agent_bot's .env stores these same hosts *with* the suffix because its
# clients append bare paths; copying those values here would 404 everything.
BOXTRUCK_BASE_URL=https://boxmanage.smartfleetllc.com
BOXTRUCK_INTERNAL_SECRET=
ATREK_BASE_URL=http://localhost:8080
ATREK_INTERNAL_SECRET=

# nylas v3
NYLAS_API_KEY=
NYLAS_API_URI=https://api.us.nylas.com
NYLAS_CLIENT_ID=
NYLAS_CALLBACK_URI=https://your-host/api/v1/accounts/callback
NYLAS_WEBHOOK_SECRET=

# Where the browser lands after Nylas hosted auth finishes (the page with the
# mailbox connect card). Leave blank when the frontend and this service share
# a host — the callback then redirects to the same-origin relative path
# "/settings", which is correct for the deployed setup. Set an absolute URL
# only when the frontend is on a different origin.
FRONTEND_MAILBOX_SETTINGS_URL=

# openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# telegram — same bot token as agent_bot
TELEGRAM_BOT_TOKEN=

# 0 means a ratecon total must equal the agreed rate exactly
PRICE_TOLERANCE_CENTS=0
