# service
ENV=development
PORT=8100
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/email_agent
CORS_ORIGINS=http://localhost:3000

# database resilience — every wait is bounded so a stuck query or a starved
# pool cannot freeze the whole service. Defaults are sane; tune on the box
# without a redeploy if needed.
#   DB_POOL_TIMEOUT_SECONDS  how long a connection checkout may block (was 30)
#   DB_STATEMENT_TIMEOUT_MS  Postgres aborts a single query slower than this
#   DB_IDLE_TX_TIMEOUT_MS    Postgres drops a transaction left open this long,
#                            freeing the connection a stalled handler was holding
DB_POOL_TIMEOUT_SECONDS=10
DB_STATEMENT_TIMEOUT_MS=15000
DB_IDLE_TX_TIMEOUT_MS=60000

# auth — must match Django's SIMPLE_JWT signing key (defaults to SECRET_KEY)
JWT_SECRET=
JWT_ALGORITHM=HS256
# shared with atrek (INTERNAL_SECRET_KEY) and boxTruck (INTERNAL_SERVICE_SECRET)
INTERNAL_SECRET_KEY=

# peer services — ORIGIN ONLY, no /api or /api/v1 suffix.
# agent_bot's .env stores these same hosts *with* the suffix because its
# clients append bare paths; copying those values here would 404 everything.
BOXTRUCK_BASE_URL=https://boxmanage.smartfleetllc.com
BOXTRUCK_INTERNAL_SECRET=
ATREK_BASE_URL=http://localhost:8080
ATREK_INTERNAL_SECRET=

# nylas v3 — this service owns the Nylas application and receives broker mail
# straight from Nylas. Nothing is relayed through a peer server.
#
# NYLAS_API_KEY and NYLAS_WEBHOOK_SECRET are secrets; keep them out of git.
# NYLAS_WEBHOOK_SECRET is the value Nylas returned when the webhook was
# created — not the API key. Getting it wrong rejects every delivery with 401.
# Re-read it any time with:
#   curl -H "Authorization: Bearer $NYLAS_API_KEY" \
#        https://api.us.nylas.com/v3/webhooks
NYLAS_API_KEY=
NYLAS_API_URI=https://api.us.nylas.com
NYLAS_CLIENT_ID=4ee94420-d0d6-46f3-b789-999263f0e18d
# Must also be registered on the Nylas application as a callback URI, or
# hosted auth refuses to redirect back here.
NYLAS_CALLBACK_URI=https://spaceline.boxtruckmanage.com/email-agent/api/v1/accounts/callback
NYLAS_WEBHOOK_SECRET=

# Where the browser lands after Nylas hosted auth finishes (the page with the
# mailbox connect card). Leave blank when the frontend and this service share
# a host — the callback then redirects to the same-origin relative path
# "/settings", which is correct for the deployed setup. Set an absolute URL
# only when the frontend is on a different origin.
FRONTEND_MAILBOX_SETTINGS_URL=

# openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# telegram — same bot token as agent_bot
TELEGRAM_BOT_TOKEN=

# 0 means a ratecon total must equal the agreed rate exactly
PRICE_TOLERANCE_CENTS=0
